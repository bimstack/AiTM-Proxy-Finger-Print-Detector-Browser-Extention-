{
  "manifest_version": 3,
  "name": "AiTM Proxy Fingerprint Detector",
  "version": "1.0.0",
  "description": "Detects Adversary-in-the-Middle reverse proxy phishing attacks by analyzing HTTP headers, TLS metadata, DOM content, URL structure, and network timing.",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AiTM Proxy Fingerprint Detector",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/constants.js",
        "content/idp-signatures.js",
        "content/detector.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "minimum_chrome_version": "116"
}
